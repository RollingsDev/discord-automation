{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oraculo-tft",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-20",
  "vars": {
    "RIOT_REGION": "americas",
    "RIOT_PLATFORM": "br1",
    "TFT_META_URL": "https://raw.githubusercontent.com/RollingsDev/discord-automation/main/.state/tft-meta.json",
    "RIOT_ANALYTICS_URL": "https://raw.githubusercontent.com/RollingsDev/discord-automation/main/.state/riot-analytics.json"
  }
}
