# ============================================================
# SERPRO / RECEITA - obrigatório para o modo automático
# ============================================================
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=

# production = CNPJs reais contratados
# trial = ambiente de degustação/teste
SERPRO_CNPJ_MODE=production

# Normalmente não precisa alterar.
SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token

# Pode ser sobrescrita se a documentação do seu contrato mostrar outra URL.
# Production padrão usado pelo agente:
SERPRO_CNPJ_QSA_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cnpj-df/v2/qsa

# Identificador livre enviado no x-request-tag, máximo 32 caracteres.
SERPRO_REQUEST_TAG=auditoria-receita

# Guarda o JSON bruto de cada consulta dentro do ZIP.
SERPRO_KEEP_RAW=1
SERPRO_TIMEOUT_MS=30000
SERPRO_DELAY_MS=150

# ============================================================
# PLANILHA FIXA
# ============================================================
# Se preenchido, /receita lote funciona sem anexar planilha.
# Exemplo WSL:
# RECEITA_WORKBOOK_PATH=/home/andre/Auditoria/estrutura prototipo.xlsx
RECEITA_WORKBOOK_PATH=

# 0 = processa todos os CNPJs.
RECEITA_LIMIT=0

# ============================================================
# DISCORD - necessário somente para usar /receita
# ============================================================
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_AUDITOR_CHANNEL_ID=
DISCORD_AUDITOR_USER_ID=

# Limite conservador para anexos enviados pelo bot.
# O ZIP completo continua salvo localmente quando precisa ser dividido.
DISCORD_UPLOAD_MAX_MB=9
