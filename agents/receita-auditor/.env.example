# Discord — aplicativo exclusivo do Auditor Receita
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_AUDITOR_CHANNEL_ID=
DISCORD_AUDITOR_USER_ID=

# Limite conservador para anexos enviados pelo bot.
# O ZIP completo continua salvo no computador mesmo quando precisa ser dividido.
DISCORD_UPLOAD_MAX_MB=9

# Opcional. Se vazio, usa ./data/browser-profile
RECEITA_BROWSER_PROFILE=

# Opcional. 0 = processa tudo
RECEITA_LIMIT=0
